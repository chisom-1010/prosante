# Copy to .env.local and fill in. Never commit real values.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# The public (anon / publishable) key. Set ONE of these; the code reads the
# first one that is defined (lib/supabase/env.ts):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Server only. Bypasses RLS: used by lib/supabase/admin.ts after the
# caller's role has been checked. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
# Base URL used for links inside emails (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://prosantes.site

# --- Admin seed script (scripts/seedAdmin.ts) --------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
