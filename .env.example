# Copy to .env.local and fill in. Never commit real values.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# The public (anon / publishable) key is currently read under three different
# names by three files. Until they're unified, set the same key in all of them:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=   # lib/supabase/client.ts
NEXT_PUBLIC_SUPABASE_ANON_KEY=                  # lib/supabase/server.ts
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=           # lib/supabase/middleware.ts (not wired yet)
# SECRET. Server only. Bypasses RLS: used by lib/supabase/admin.ts after the
# caller's role has been checked. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
# Base URL used for links inside emails (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://prosantes.site

# --- Admin seed script (scripts/seedAdmin.ts) --------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
